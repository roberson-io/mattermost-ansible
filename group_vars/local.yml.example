---
# Local development environment configuration

# PostgreSQL configuration
postgresql_version: "16"  # Note: Mattermost v11.0+ requires PostgreSQL 14 or higher
postgresql_allow_remote: true
postgresql_listen_addresses: "*"
postgresql_db_name: mattermost
postgresql_db_user: mmuser
postgresql_db_password: "{{ vault_local_db_password }}"

# Mattermost configuration
# Note: mattermost_db_host and mattermost_site_url are set dynamically in site.yml
# using facts gathered from the hosts

# Configuration storage: "file" (default) or "database"
# - "file": Config stored in config.json (suitable for single-server)
# - "database": Config stored in database (recommended for HA clusters)
mattermost_config_storage: "database"

mattermost_version: "11.0.4"
mattermost_db_port: 5432
mattermost_db_name: mattermost
mattermost_db_user: mmuser
mattermost_db_password: "{{ vault_local_db_password }}"

# License configuration (optional)
# Uncomment and set path to your license file to activate Enterprise features
mattermost_license_file: "license.mattermost"
mattermost_service_environment: "test"  # Options: test, production, or dev

# Mattermost Calls configuration (optional)
# Enable Calls by setting enable_calls to true and configuring an rtcd host in inventory
enable_calls: true

# Mattermost Boards configuration (optional)
# Enable Boards plugin for project management features
mattermost_enable_boards: true
mattermost_boards_version: "9.2.0"
# rtcd_version: "v1.2.1"
# rtcd_api_listen_address: "0.0.0.0:8045"
# rtcd_ice_port_udp: 8443
# rtcd_ice_port_tcp: 8443

# MinIO Object Storage configuration (optional)
# Enable MinIO by setting enable_minio to true and configuring a minio host in inventory
# enable_minio: true
# mattermost_enable_s3: true
# mattermost_s3_endpoint: "{{ mattermost_minio_host | default('localhost') }}:9000"
# mattermost_s3_bucket: "mattermost"
# mattermost_s3_region: "us-east-1"
# mattermost_s3_access_key_id: "{{ vault_local_minio_access_key }}"
# mattermost_s3_secret_access_key: "{{ vault_local_minio_secret_key }}"
# mattermost_s3_secure: false  # Set to true if using TLS
# MinIO server configuration (when enable_minio is true):
# minio_root_user: "{{ vault_local_minio_access_key }}"
# minio_root_password: "{{ vault_local_minio_secret_key }}"

# Keycloak Identity Provider configuration (optional)
# Enable Keycloak by setting enable_keycloak to true and configuring a keycloak host in inventory
# enable_keycloak: true
# keycloak_version: "26.4.2"  # Optional: specify version
# keycloak_hostname: "localhost"
# keycloak_admin_user: admin
# keycloak_admin_password: "{{ vault_local_keycloak_admin_password }}"
# keycloak_db_name: keycloak
# keycloak_db_user: keycloak
# keycloak_db_password: "{{ vault_local_keycloak_db_password }}"

# OpenLDAP Directory Services configuration (optional)
# Enable OpenLDAP by setting enable_ldap to true and configuring ldap hosts in inventory
# Note: Per-instance LDAP configuration (ldap1, ldap2, etc.) is in separate files
# at group_vars/ldap1.yml, group_vars/ldap2.yml, etc.
# This allows different base DNs, organizations, and TLS settings per instance.
# The ldap*.yml files use environment-aware vault lookups to work across all environments.
# See group_vars/ldap*.yml.example for available configuration options.
# enable_ldap: true

# Redis Cache configuration (optional)
# Enable Redis by setting enable_redis to true and configuring a redis host in inventory
# enable_redis: true
# mattermost_enable_redis: true
# mattermost_redis_password: "{{ vault_local_redis_password }}"
# redis_requirepass: "{{ vault_local_redis_password }}"

# Elasticsearch Search configuration (optional)
# Enable Elasticsearch by setting enable_elasticsearch to true and configuring an elasticsearch host in inventory
# Note: Local development uses Elasticsearch 7.17 due to OrbStack/Docker seccomp limitations
# Production/staging should use Elasticsearch 8.x (default)
# enable_elasticsearch: true
# mattermost_enable_elasticsearch: true
# elasticsearch_major_version: "7"  # Use "7" for local (OrbStack), "8" for production
# elasticsearch_version: "7.17.27"  # Specific version
# elasticsearch_system_call_filter: "false"  # Required for containerized environments without seccomp
# Elasticsearch connection is auto-configured from inventory
# Optional: Set these if using ES8 with security enabled
# mattermost_elasticsearch_username: "elastic"
# mattermost_elasticsearch_password: "{{ vault_local_elasticsearch_password }}"

# No nginx/TLS for local development
use_nginx: false
use_tls: false
