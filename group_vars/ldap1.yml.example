---
# OpenLDAP instance 1 configuration
# Copy this file and customize for additional instances (ldap2.yml, ldap3.yml, etc.)
# Remember to add corresponding vault passwords in group_vars/all.yml

# Enable this LDAP instance
enable_ldap: true

# Version configuration
openldap_version: "2.6.10"  # LTS version

# Instance identification
openldap_instance_name: "ldap1"

# Network configuration
openldap_port: 389
openldap_tls_port: 636
openldap_listen_address: "0.0.0.0"

# Directory configuration
openldap_base_dn: "dc=example,dc=com"
openldap_organization: "Example Organization"
openldap_domain: "example.com"
openldap_admin_cn: "admin"
openldap_admin_password: "{{ vault_local_ldap1_admin_password }}"
openldap_config_password: "{{ vault_local_ldap1_config_password }}"

# Schemas to load (core is always loaded automatically)
openldap_schemas:
  - cosine
  - inetorgperson
  - nis

# TLS/LDAPS configuration
openldap_tls_enabled: false
# openldap_tls_cert_file: "/etc/ssl/certs/ldap.crt"
# openldap_tls_key_file: "/etc/ssl/private/ldap.key"
# openldap_tls_ca_file: "/etc/ssl/certs/ca.crt"

# Logging level
# Options: none, stats, packets, args, conns, BER, filter, config, ACL, sync, any
openldap_log_level: "stats"

# Database configuration
openldap_database_type: "mdb"  # Modern LMDB backend
openldap_database_max_size: 1073741824  # 1GB

# Access control rules
openldap_access_rules:
  - "to attrs=userPassword by self write by anonymous auth by * none"
  - "to attrs=shadowLastChange by self write by * read"
  - "to * by * read"

# Performance indexes
openldap_indexes:
  - "objectClass eq"
  - "uid eq,pres,sub"
  - "cn eq,pres,sub"
  - "sn eq,pres,sub"
  - "mail eq,pres,sub"
  - "ou eq,pres,sub"
  - "dc eq"
  - "entryCSN eq"
  - "entryUUID eq"
