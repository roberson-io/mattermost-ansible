---
# Local HA cluster environment configuration (minimal for testing)
# Copy this file to local-ha.yml:
#   cp group_vars/local-ha.yml.example group_vars/local-ha.yml
#
# Note: This minimal config excludes Redis (only needed for 100K+ users)
# and Elasticsearch (recommended for 2.5M+ posts, required for 5M+ posts)

# Mattermost license file (required for Enterprise features like HA)
mattermost_license_file: "license.mattermost"

# Service environment (test mode required for test licenses)
mattermost_service_environment: "test"
# PostgreSQL configuration
postgresql_version: "16"
postgresql_allow_remote: true
postgresql_listen_addresses: "*"
postgresql_db_name: mattermost
postgresql_db_user: mmuser
postgresql_db_password: "{{ vault_local_db_password }}"

# PostgreSQL HA Performance Tuning (scaled for local testing)
# For local VMs with limited resources, use conservative values
postgresql_max_connections: 200  # Lower than production
postgresql_shared_buffers: "256MB"  # Adjust based on VM RAM
postgresql_effective_cache_size: "1GB"  # Adjust based on VM RAM
postgresql_work_mem: "4MB"
postgresql_maintenance_work_mem: "128MB"
postgresql_random_page_cost: 1.1  # Assuming SSD
postgresql_autovacuum_max_workers: 3
postgresql_max_worker_processes: 8

# Mattermost configuration
mattermost_version: "11.0.4"
mattermost_db_host: "{{ hostvars[groups['database'][0]]['ansible_default_ipv4']['address'] }}"
mattermost_db_port: 5432
mattermost_db_name: mattermost
mattermost_db_user: mmuser
mattermost_db_password: "{{ vault_local_db_password }}"
mattermost_site_url: "http://{{ hostvars[groups['loadbalancer'][0]]['ansible_default_ipv4']['address'] }}"

# Configuration storage: database (required for HA)
mattermost_config_storage: "database"

# High Availability cluster configuration
mattermost_enable_cluster: true
mattermost_cluster_name: "local-ha"
mattermost_cluster_use_ip_address: true
mattermost_gossip_port: 8074
mattermost_streaming_port: 8075
mattermost_cluster_read_only_config: true

# MinIO Object Storage (REQUIRED for HA cluster)
enable_minio: true
mattermost_enable_s3: true
mattermost_s3_endpoint: "{{ hostvars[groups['minio'][0]]['ansible_default_ipv4']['address'] }}:9000"
mattermost_s3_bucket: "mattermost"
mattermost_s3_region: "us-east-1"
mattermost_s3_access_key_id: "{{ vault_local_minio_access_key }}"
mattermost_s3_secret_access_key: "{{ vault_local_minio_secret_key }}"
mattermost_s3_secure: false  # Set to false for local testing without TLS

# MinIO server configuration
minio_root_user: "{{ vault_local_minio_access_key }}"
minio_root_password: "{{ vault_local_minio_secret_key }}"

# Load balancer configuration (automatically configured by site.yml)
# nginx_mode will be set to "load_balancer" automatically when multiple app nodes detected
nginx_server_name: mattermost-ha.local
nginx_lb_algorithm: "ip_hash"  # Sticky sessions for WebSocket
nginx_max_fails: 3
nginx_fail_timeout: 30
nginx_ssl_enabled: false  # Disable SSL for local testing
use_nginx: true

# Optional: System limits and network optimizations (for HA testing)
# Uncomment to test these features
# mattermost_configure_system_limits: true
# mattermost_max_open_files: 65536
# mattermost_max_processes: 8192
# mattermost_configure_network_optimizations: true

# Skip database backups for faster local testing (NOT recommended for production)
# mattermost_skip_db_backup: true
