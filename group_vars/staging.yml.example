---
# Staging environment configuration

# PostgreSQL configuration
postgresql_version: "16"  # Note: Mattermost v11.0+ requires PostgreSQL 14 or higher
postgresql_allow_remote: true
postgresql_listen_addresses: "*"
postgresql_db_name: mattermost
postgresql_db_user: mmuser
postgresql_db_password: "{{ vault_staging_db_password }}"

# PostgreSQL HA Performance Tuning (recommended for staging HA clusters)
# Adjust based on available system resources
# postgresql_max_connections: 512  # Lower than production for staging
# postgresql_shared_buffers: "8GB"  # Adjust based on staging server RAM
# postgresql_effective_cache_size: "24GB"  # Adjust based on staging server RAM
# postgresql_work_mem: "16MB"  # For staging
# postgresql_maintenance_work_mem: "512MB"  # For staging
# postgresql_random_page_cost: 1.1  # For SSD storage
# postgresql_autovacuum_max_workers: 3  # For staging
# postgresql_max_worker_processes: 8  # For staging

# Database Read Replicas for HA (optional)
# mattermost_db_replicas:
#   - "postgres://{{ postgresql_db_user }}:{{ vault_staging_db_password }}@replica1-staging.example.com:5432/{{ postgresql_db_name }}?sslmode=disable"
# mattermost_db_search_replicas:
#   - "postgres://{{ postgresql_db_user }}:{{ vault_staging_db_password }}@search-replica-staging.example.com:5432/{{ postgresql_db_name }}?sslmode=disable"

# Mattermost configuration
mattermost_version: "11.0.4"
mattermost_db_host: "{{ hostvars[groups['database'][0]]['ansible_default_ipv4']['address'] }}"
mattermost_db_port: 5432
mattermost_db_name: mattermost
mattermost_db_user: mmuser
mattermost_db_password: "{{ vault_staging_db_password }}"
mattermost_site_url: "https://{{ nginx_server_name }}"

# Configuration storage: "file" (default) or "database"
# - "file": Config stored in config.json (suitable for single-server)
# - "database": Config stored in database (recommended for HA clusters)
mattermost_config_storage: "database"

# Nginx and TLS configuration
use_nginx: true
use_tls: true
nginx_server_name: staging.mattermost.example.com
nginx_upstream_host: localhost
nginx_upstream_port: 8065
nginx_ssl_enabled: true
nginx_force_https: true

# Certbot/Let's Encrypt
certbot_email: admin@example.com
certbot_domain: "{{ nginx_server_name }}"
certbot_create_if_missing: true

# License configuration (optional)
# Uncomment and set path to your license file to activate Enterprise features
# mattermost_license_file: "license.mattermost"
# mattermost_service_environment: "production"  # Options: test, production, or dev

# Mattermost Calls configuration (optional)
# Enable Calls by setting enable_calls to true and configuring an rtcd host in inventory
# enable_calls: true
# rtcd_version: "v1.2.1"
# rtcd_api_listen_address: "0.0.0.0:8045"
# rtcd_ice_port_udp: 8443
# rtcd_ice_port_tcp: 8443

# Mattermost Boards configuration (optional)
# Enable Boards plugin for project management features
# mattermost_enable_boards: true
# mattermost_boards_version: "9.2.0"

# MinIO Object Storage configuration (optional)
# Enable MinIO by setting enable_minio to true and configuring a minio host in inventory
# enable_minio: true
# mattermost_enable_s3: true
# mattermost_s3_endpoint: "{{ mattermost_minio_host | default('localhost') }}:9000"
# mattermost_s3_bucket: "mattermost"
# mattermost_s3_region: "us-east-1"
# mattermost_s3_access_key_id: "{{ vault_staging_minio_access_key }}"
# mattermost_s3_secret_access_key: "{{ vault_staging_minio_secret_key }}"
# mattermost_s3_secure: true  # Set to false if not using TLS
# MinIO server configuration (when enable_minio is true):
# minio_root_user: "{{ vault_staging_minio_access_key }}"
# minio_root_password: "{{ vault_staging_minio_secret_key }}"

# Keycloak Identity Provider configuration (optional)
# Enable Keycloak by setting enable_keycloak to true and configuring a keycloak host in inventory
# enable_keycloak: true
# keycloak_version: "26.4.2"  # Optional: specify version
# keycloak_hostname: "keycloak-staging.example.com"
# keycloak_admin_user: admin
# keycloak_admin_password: "{{ vault_staging_keycloak_admin_password }}"
# keycloak_db_name: keycloak
# keycloak_db_user: keycloak
# keycloak_db_password: "{{ vault_staging_keycloak_db_password }}"

# OpenLDAP Directory Services configuration (optional)
# Enable OpenLDAP by setting enable_ldap to true and configuring ldap hosts in inventory
# Note: Per-instance LDAP configuration (ldap1, ldap2, etc.) is in separate files
# at group_vars/ldap1.yml, group_vars/ldap2.yml, etc.
# This allows different base DNs, organizations, and TLS settings per instance.
# The ldap*.yml files use environment-aware vault lookups to work across all environments.
# See group_vars/ldap*.yml.example for available configuration options.
# enable_ldap: true

# Redis Cache configuration (optional)
# Enable Redis by setting enable_redis to true and configuring a redis host in inventory
# enable_redis: true
# mattermost_enable_redis: true
# mattermost_redis_password: "{{ vault_staging_redis_password }}"
# redis_requirepass: "{{ vault_staging_redis_password }}"

# Elasticsearch Search configuration (optional)
# Enable Elasticsearch by setting enable_elasticsearch to true and configuring an elasticsearch host in inventory
# Recommended for deployments with over 5 million posts
# enable_elasticsearch: true
# mattermost_enable_elasticsearch: true
# Elasticsearch 8.x is the default (recommended for production/staging with proper kernel support)
# elasticsearch_major_version: "8"  # Default, can use "7" if needed
# elasticsearch_version: "8.16.1"  # Specific version
# Elasticsearch connection is auto-configured from inventory
# Optional: Authentication (required for ES8 with security enabled)
# mattermost_elasticsearch_username: "elastic"
# mattermost_elasticsearch_password: "{{ vault_staging_elasticsearch_password }}"
# Optional: TLS/Security settings (recommended for staging)
# mattermost_elasticsearch_skip_tls_verification: false
# mattermost_elasticsearch_ca_path: "./elasticsearch/ca.pem"  # Custom CA certificate (PEM format)
# mattermost_elasticsearch_client_cert_path: "./elasticsearch/client-cert.pem"  # Client cert for mTLS (PEM format)
# mattermost_elasticsearch_client_key_path: "./elasticsearch/client-key.pem"  # Client key for mTLS (PEM format)
# Multi-node cluster configuration (for testing enterprise scale, 2-4 nodes recommended):
# elasticsearch_cluster_mode: "multi"  # Set to "multi" for cluster, "single" for single-node
# elasticsearch_heap_size: "8g"  # Adjust based on staging environment
# Seed hosts and initial master nodes are auto-configured from inventory

# High Availability cluster configuration (optional)
# Requires: mattermost_config_storage: "database" and mattermost_enable_s3: true
# Refer to Mattermost reference architectures for node count based on your scale
# mattermost_enable_cluster: true
# mattermost_cluster_name: "staging"
# mattermost_cluster_use_ip_address: true
# mattermost_gossip_port: 8074  # Port for gossip protocol communication
# mattermost_streaming_port: 8075  # Port for streaming API communication
# mattermost_cluster_read_only_config: true  # Make config.json read-only (recommended)
# Load balancer configuration (required for HA cluster):
# nginx_mode: "load_balancer"  # Automatically set when multiple app nodes detected
# nginx_lb_algorithm: "ip_hash"  # Options: "round_robin", "least_conn", "ip_hash" (recommended for WebSocket)
# nginx_max_fails: 3  # Failed health checks before marking server unavailable
# nginx_fail_timeout: 30  # Seconds to mark server unavailable after max_fails

# System Limits and Network Optimizations (recommended for HA cluster)
# mattermost_configure_system_limits: true  # Configure ulimits for Mattermost
# mattermost_max_open_files: 65536  # Maximum open files (ulimit -n)
# mattermost_max_processes: 8192  # Maximum processes (ulimit -u)
# mattermost_configure_network_optimizations: true  # Configure TCP/IP tuning for HA
