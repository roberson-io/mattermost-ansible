[database]
# Replace with your production database server
db.example.com ansible_user=ubuntu

[app]
# Replace with your production app server
app.example.com ansible_user=ubuntu

[rtcd]
# Optional: Enable Mattermost Calls by uncommenting and configuring
# rtcd.example.com ansible_user=ubuntu

[minio]
# Optional: Enable MinIO object storage by uncommenting and configuring
# minio.example.com ansible_user=ubuntu

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# keycloak.example.com ansible_user=ubuntu

[production:children]
database
app
rtcd
minio
keycloak

[production:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=production
