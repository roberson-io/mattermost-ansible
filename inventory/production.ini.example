[database]
# Replace with your production database server
db.example.com ansible_user=ubuntu

[app]
# Replace with your production app server
app.example.com ansible_user=ubuntu

[rtcd]
# Optional: Enable Mattermost Calls by uncommenting and configuring
# rtcd.example.com ansible_user=ubuntu

[minio]
# Optional: Enable MinIO object storage by uncommenting and configuring
# minio.example.com ansible_user=ubuntu

[redis]
# Optional: Enable Redis cache by uncommenting and configuring
# redis.example.com ansible_user=ubuntu

# Elasticsearch search (optional, supports single-node or multi-node cluster)
# Single-node deployment (small scale):
# [elasticsearch]
# elasticsearch.example.com ansible_user=ubuntu

# Multi-node cluster deployment (enterprise scale with 5M+ posts, 2-4 nodes recommended):
# [elasticsearch1]
# elasticsearch1.example.com ansible_user=ubuntu

# [elasticsearch2]
# elasticsearch2.example.com ansible_user=ubuntu

# [elasticsearch3]
# elasticsearch3.example.com ansible_user=ubuntu

# Parent group for all elasticsearch instances (required for multi-node)
[elasticsearch:children]
# elasticsearch1
# elasticsearch2
# elasticsearch3

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# keycloak.example.com ansible_user=ubuntu

# OpenLDAP instances (optional, support multiple)
# Uncomment and add as many LDAP instances as needed (ldap1, ldap2, ldap3, etc.)
# [ldap1]
# ldap1.example.com ansible_user=ubuntu

# [ldap2]
# ldap2.example.com ansible_user=ubuntu

# Parent group for all LDAP instances
[ldap:children]
# ldap1
# ldap2

[production:children]
database
app
rtcd
minio
redis
elasticsearch
keycloak
ldap

[production:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=production
