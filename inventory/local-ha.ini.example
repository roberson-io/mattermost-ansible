# Local HA cluster environment inventory (minimal 2-node cluster for testing)
# Copy this file to local-ha.ini and customize for your setup:
#   cp inventory/local-ha.ini.example inventory/local-ha.ini
#
# Minimal HA configuration: database + 2 app nodes + load balancer + MinIO
# Tests: Mattermost cluster, nginx load balancing, shared S3 storage, PostgreSQL HA tuning
#
# To create VMs with OrbStack:
#   make orb-create-vm-postgresql-rocky
#   make orb-create-vm-app1-rocky
#   make orb-create-vm-app2-rocky
#   make orb-create-vm-loadbalancer-rocky
#   make orb-create-vm-minio-rocky
#
# Or use the HA cluster target (includes redis):
#   make orb-create-vms-ha-cluster-rocky
#
# To deploy:
#   ansible-playbook -i inventory/local-ha.ini site.yml

[database]
# PostgreSQL database server
YOUR_USER@postgresql-rocky@orb

# Multi-node Mattermost HA cluster (2 nodes minimum)
[app1]
YOUR_USER@mattermost1-rocky@orb

[app2]
YOUR_USER@mattermost2-rocky@orb

# Parent group for all app instances (required for multi-node)
[app:children]
app1
app2

# Load balancer (nginx) - Required for multi-node HA cluster
[loadbalancer]
YOUR_USER@loadbalancer-rocky@orb

# MinIO Object Storage - REQUIRED for HA cluster (shared file storage)
[minio]
YOUR_USER@minio-rocky@orb

# Redis Cache - Optional, only needed for very large deployments (100,000+ users)
# [redis]
# YOUR_USER@redis-rocky@orb

# Elasticsearch - Optional, recommended for 2.5M+ posts, required for 5M+ posts
# [elasticsearch]
# YOUR_USER@elasticsearch-rocky@orb

# Optional services
# [rtcd]
# YOUR_USER@rtcd-rocky@orb

# [keycloak]
# YOUR_USER@keycloak-rocky@orb

[local_ha:children]
database
app
loadbalancer
minio

[local_ha:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=local-ha
