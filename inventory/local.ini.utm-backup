# Local development environment inventory
# Copy this file to local.ini and customize for your setup:
#   cp inventory/local.ini.example inventory/local.ini
#
# Connection format examples:
#
# OrbStack:
#   user@hostname@orb
#
# Multipass:
#   user@hostname.mshome.net
#
# VirtualBox/Vagrant with IP:
#   192.168.56.10 ansible_user=vagrant
#
# Standard SSH:
#   hostname ansible_user=user ansible_host=192.168.1.10

[database]
postgres-rocky ansible_host=192.168.64.5 ansible_user=michaelroberson

# Single-node Mattermost (default):
# [app]
# michaelroberson@mattermost-rocky@orb

# Multi-node Mattermost HA cluster:
# REQUIREMENTS for HA cluster:
#   - 2+ app nodes (using [app:children] pattern below)
#   - Load balancer (nginx) - REQUIRED
#   - MinIO or S3 storage - REQUIRED for shared file storage
#   - Database config storage - REQUIRED (set mattermost_config_storage: "database")
#   - Enterprise license - REQUIRED (Free edition doesn't support clustering)
#   - Redis - Optional, recommended for 100,000+ users
#   - Elasticsearch - Optional, recommended for 2.5M+ posts
# Number of nodes depends on your reference architecture (see Mattermost scaling docs)
[app1]
mattermost1-rocky ansible_host=192.168.64.6 ansible_user=michaelroberson

[app2]
mattermost2-rocky ansible_host=192.168.64.7 ansible_user=michaelroberson

# Add more app nodes as needed (app3, app4, etc.)
# [app3]
# mattermost3-rocky ansible_host=192.168.64.10 ansible_user=michaelroberson

# Parent group for all app instances (required for multi-node)
[app:children]
app1
app2

# Load balancer (nginx) - Required for multi-node HA cluster
[loadbalancer]
nginx-rocky ansible_host=192.168.64.9 ansible_user=michaelroberson

[rtcd]
# michaelroberson@rtcd-rocky@orb

[coturn]
# michaelroberson@coturn-rocky@orb

[calls_offloader]
# michaelroberson@calls-offloader-rocky@orb

[minio]
# Optional for single-node, REQUIRED for HA cluster (shared file storage)
minio-rocky ansible_host=192.168.64.8 ansible_user=michaelroberson

[redis]
# Optional: Enable Redis cache by uncommenting and configuring
# Example: your_user@redis@orb
# YOUR_USER@YOUR_REDIS_HOST

# Elasticsearch search (optional, supports single-node or multi-node cluster)
# Single-node deployment (development/small scale):
# [elasticsearch]
# YOUR_USER@YOUR_ELASTICSEARCH_HOST

# Multi-node cluster deployment (production/enterprise scale, 2-4 nodes recommended):
# Uncomment and configure multiple elasticsearch instances
# [elasticsearch1]
# Example: your_user@elasticsearch1@orb
# YOUR_USER@YOUR_ELASTICSEARCH1_HOST

# [elasticsearch2]
# Example: your_user@elasticsearch2@orb
# YOUR_USER@YOUR_ELASTICSEARCH2_HOST

# [elasticsearch3]
# Example: your_user@elasticsearch3@orb
# YOUR_USER@YOUR_ELASTICSEARCH3_HOST

# Parent group for all elasticsearch instances (required for multi-node)
[elasticsearch:children]
# elasticsearch1
# elasticsearch2
# elasticsearch3

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# Example: your_user@keycloak@orb
# YOUR_USER@YOUR_KEYCLOAK_HOST

# OpenLDAP instances (optional, support multiple)
# Uncomment and add as many LDAP instances as needed (ldap1, ldap2, ldap3, etc.)
# [ldap1]
# Example: your_user@ldap1@orb
# YOUR_USER@YOUR_LDAP1_HOST

# [ldap2]
# Example: your_user@ldap2@orb
# YOUR_USER@YOUR_LDAP2_HOST

# Parent group for all LDAP instances
[ldap:children]
# ldap1
# ldap2

[monitoring]
# Optional: Enable Prometheus and Grafana monitoring by uncommenting and configuring
# Example: your_user@monitoring@orb
# michaelroberson@monitoring-rocky@orb

[local:children]
database
app
loadbalancer
rtcd
coturn
calls_offloader
minio
redis
elasticsearch
keycloak
ldap
monitoring

[local:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=local
ansible_password=Mattermost-Ansible2025!
ansible_become_password=Mattermost-Ansible2025!
