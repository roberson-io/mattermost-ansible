# Local development environment inventory
# Copy this file to local.ini and customize for your setup:
#   cp inventory/local.ini.example inventory/local.ini
#
# Connection format examples:
#
# OrbStack:
#   hostname@orb ansible_user=your_user
#
# Multipass:
#   hostname.mshome.net ansible_user=your_user
#
# VirtualBox/Vagrant with IP:
#   hostname ansible_host=192.168.56.10 ansible_user=vagrant
#
# Standard SSH:
#   hostname ansible_user=your_user ansible_host=192.168.1.10

[database]
# Example: postgresql@orb ansible_user=your_user
YOUR_DB_HOST

# Single-node Mattermost (default):
[app]
# Example: mattermost@orb ansible_user=your_user
YOUR_APP_HOST

# Multi-node Mattermost HA cluster:
# REQUIREMENTS for HA cluster:
#   - 2+ app nodes (using [app:children] pattern below)
#   - Load balancer (nginx) - REQUIRED
#   - Shared file storage - REQUIRED (choose ONE):
#     * MinIO/S3 object storage (enable_minio: true, mattermost_enable_s3: true)
#     * NFS shared storage (enable_nfs: true, mattermost_enable_nfs: true)
#   - Database config storage - REQUIRED (set mattermost_config_storage: "database")
#   - Enterprise license - REQUIRED (Free edition doesn't support clustering)
#   - Redis - Optional, recommended for 100,000+ users
#   - Elasticsearch - Optional, recommended for 2.5M+ posts
# Number of nodes depends on your reference architecture (see Mattermost scaling docs)
# [app1]
# Example: mattermost1@orb ansible_user=your_user
# YOUR_APP1_HOST

# [app2]
# Example: mattermost2@orb ansible_user=your_user
# YOUR_APP2_HOST

# Add more app nodes as needed (app3, app4, etc.)
# [app3]
# Example: mattermost3@orb ansible_user=your_user
# YOUR_APP3_HOST

# Parent group for all app instances (required for multi-node)
# [app:children]
# app1
# app2
# Add all app nodes here

# Load balancer (nginx) - Required for multi-node HA cluster
# [loadbalancer]
# Example: loadbalancer@orb ansible_user=your_user
# YOUR_LOADBALANCER_HOST

[rtcd]
# Optional: Enable Mattermost Calls by uncommenting and configuring
# Example: rtcd@orb ansible_user=your_user
# YOUR_RTCD_HOST

[coturn]
# Optional: TURN server for Mattermost Calls (needed for restrictive firewalls)
# Example: coturn@orb ansible_user=your_user
# YOUR_COTURN_HOST

[calls_offloader]
# Optional: Call recording/transcription service (requires Docker)
# Example: calls-offloader@orb ansible_user=your_user
# YOUR_CALLS_OFFLOADER_HOST

[minio]
# Optional for single-node, one option for HA cluster shared file storage
# Example: minio@orb ansible_user=your_user
# YOUR_MINIO_HOST

[nfs]
# Optional: NFS server for shared file storage (alternative to MinIO/S3)
# Example: nfs@orb ansible_user=your_user
# YOUR_NFS_HOST

[redis]
# Optional: Enable Redis cache by uncommenting and configuring
# Example: redis@orb ansible_user=your_user
# YOUR_REDIS_HOST

# Elasticsearch search (optional, supports single-node or multi-node cluster)
# Single-node deployment (development/small scale):
# [elasticsearch]
# YOUR_USER@YOUR_ELASTICSEARCH_HOST

# Multi-node cluster deployment (production/enterprise scale, 2-4 nodes recommended):
# Uncomment and configure multiple elasticsearch instances
# [elasticsearch1]
# Example: elasticsearch1@orb ansible_user=your_user
# YOUR_ELASTICSEARCH1_HOST

# [elasticsearch2]
# Example: elasticsearch2@orb ansible_user=your_user
# YOUR_ELASTICSEARCH2_HOST

# [elasticsearch3]
# Example: elasticsearch3@orb ansible_user=your_user
# YOUR_ELASTICSEARCH3_HOST

# Parent group for all elasticsearch instances (required for multi-node)
[elasticsearch:children]
# elasticsearch1
# elasticsearch2
# elasticsearch3

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# Example: keycloak@orb ansible_user=your_user
# YOUR_KEYCLOAK_HOST

# OpenLDAP instances (optional, support multiple)
# Uncomment and add as many LDAP instances as needed (ldap1, ldap2, ldap3, etc.)
# [ldap1]
# Example: ldap1@orb ansible_user=your_user
# YOUR_LDAP1_HOST

# [ldap2]
# Example: ldap2@orb ansible_user=your_user
# YOUR_LDAP2_HOST

# Parent group for all LDAP instances
[ldap:children]
# ldap1
# ldap2

[local:children]
database
app
loadbalancer
rtcd
coturn
calls_offloader
minio
nfs
redis
elasticsearch
keycloak
ldap

[local:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=local
