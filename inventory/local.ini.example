# Local development environment inventory
# Copy this file to local.ini and customize for your setup:
#   cp inventory/local.ini.example inventory/local.ini
#
# Connection format examples:
#
# OrbStack:
#   user@hostname@orb
#
# Multipass:
#   user@hostname.mshome.net
#
# VirtualBox/Vagrant with IP:
#   192.168.56.10 ansible_user=vagrant
#
# Standard SSH:
#   hostname ansible_user=user ansible_host=192.168.1.10

[database]
# Example: your_user@postgresql@orb
YOUR_USER@YOUR_DB_HOST

[app]
# Example: your_user@mattermost@orb
YOUR_USER@YOUR_APP_HOST

[rtcd]
# Optional: Enable Mattermost Calls by uncommenting and configuring
# Example: your_user@rtcd@orb
# YOUR_USER@YOUR_RTCD_HOST

[minio]
# Optional: Enable MinIO object storage by uncommenting and configuring
# Example: your_user@minio@orb
# YOUR_USER@YOUR_MINIO_HOST

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# Example: your_user@keycloak@orb
# YOUR_USER@YOUR_KEYCLOAK_HOST

# OpenLDAP instances (optional, support multiple)
# Uncomment and add as many LDAP instances as needed (ldap1, ldap2, ldap3, etc.)
# [ldap1]
# Example: your_user@ldap1@orb
# YOUR_USER@YOUR_LDAP1_HOST

# [ldap2]
# Example: your_user@ldap2@orb
# YOUR_USER@YOUR_LDAP2_HOST

# Parent group for all LDAP instances
[ldap:children]
# ldap1
# ldap2

[local:children]
database
app
rtcd
minio
keycloak
ldap

[local:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=local
