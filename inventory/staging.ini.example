[database]
# Replace with your staging database server
db-staging.example.com ansible_user=ubuntu

[app]
# Replace with your staging app server
app-staging.example.com ansible_user=ubuntu

[rtcd]
# Optional: Enable Mattermost Calls by uncommenting and configuring
# rtcd-staging.example.com ansible_user=ubuntu

[minio]
# Optional: Enable MinIO object storage by uncommenting and configuring
# minio-staging.example.com ansible_user=ubuntu

[redis]
# Optional: Enable Redis cache by uncommenting and configuring
# redis-staging.example.com ansible_user=ubuntu

# Elasticsearch search (optional, supports single-node or multi-node cluster)
# Single-node deployment (small scale):
# [elasticsearch]
# elasticsearch-staging.example.com ansible_user=ubuntu

# Multi-node cluster deployment (enterprise scale testing, 2-4 nodes recommended):
# [elasticsearch1]
# elasticsearch1-staging.example.com ansible_user=ubuntu

# [elasticsearch2]
# elasticsearch2-staging.example.com ansible_user=ubuntu

# [elasticsearch3]
# elasticsearch3-staging.example.com ansible_user=ubuntu

# Parent group for all elasticsearch instances (required for multi-node)
[elasticsearch:children]
# elasticsearch1
# elasticsearch2
# elasticsearch3

[keycloak]
# Optional: Enable Keycloak identity provider by uncommenting and configuring
# keycloak-staging.example.com ansible_user=ubuntu

# OpenLDAP instances (optional, support multiple)
# Uncomment and add as many LDAP instances as needed (ldap1, ldap2, ldap3, etc.)
# [ldap1]
# ldap1-staging.example.com ansible_user=ubuntu

# [ldap2]
# ldap2-staging.example.com ansible_user=ubuntu

# Parent group for all LDAP instances
[ldap:children]
# ldap1
# ldap2

[staging:children]
database
app
rtcd
minio
redis
elasticsearch
keycloak
ldap

[staging:vars]
ansible_python_interpreter=/usr/bin/python3
deployment_environment=staging
