# Elasticsearch configuration file
# Generated by Ansible - DO NOT EDIT MANUALLY

# ======================== Elasticsearch Configuration =========================

# ---------------------------------- Cluster -----------------------------------

cluster.name: {{ elasticsearch_cluster_name }}

# ------------------------------------ Node ------------------------------------

node.name: {{ elasticsearch_node_name }}

# ----------------------------------- Paths ------------------------------------

path.data: {{ elasticsearch_data_path }}
path.logs: {{ elasticsearch_log_path }}

# ----------------------------------- Memory -----------------------------------

# Lock the memory on startup to prevent swapping
bootstrap.memory_lock: false

# ---------------------------------- Network -----------------------------------

# By default Elasticsearch is only accessible on localhost
network.host: {{ elasticsearch_network_host }}

# HTTP port
http.port: {{ elasticsearch_http_port }}

# Transport port
transport.port: {{ elasticsearch_transport_port }}

# --------------------------------- Discovery ----------------------------------

{% if elasticsearch_cluster_mode == "single" %}
# Single-node discovery (no cluster formation)
discovery.type: single-node
{% else %}
# Multi-node cluster discovery
# Seed hosts for discovering other nodes in the cluster
discovery.seed_hosts: {{ elasticsearch_discovery_seed_hosts | to_json }}

{% if elasticsearch_initial_master_nodes | length > 0 %}
# Initial master nodes for cluster bootstrapping
# IMPORTANT: Remove this setting after the cluster has formed successfully!
cluster.initial_master_nodes: {{ elasticsearch_initial_master_nodes | to_json }}
{% endif %}

# Node roles
node.master: {{ elasticsearch_node_master | lower }}
node.data: {{ elasticsearch_node_data | lower }}
node.ingest: {{ elasticsearch_node_ingest | lower }}
node.ml: {{ elasticsearch_node_ml | lower }}
{% endif %}

# ---------------------------------- Various -----------------------------------

# Require explicit names when deleting indices
{% if elasticsearch_major_version == "8" %}
action.destructive_requires_name: {{ elasticsearch_action_destructive_requires_name }}

# System call filter (seccomp) for security
# Set to false for containerized/VM environments without seccomp kernel support
bootstrap.system_call_filter: {{ elasticsearch_system_call_filter }}
{% endif %}

# ---------------------------------- Security ----------------------------------

{% if elasticsearch_major_version == "8" %}
# Enable/disable security features
xpack.security.enabled: {{ elasticsearch_enable_security }}
xpack.security.enrollment.enabled: false

# Transport layer security
xpack.security.transport.ssl.enabled: false

# HTTP layer security
xpack.security.http.ssl.enabled: false
{% endif %}

{% if elasticsearch_use_opensearch %}
# --------------------------------- OpenSearch ---------------------------------

# Disable OpenSearch security plugin for simple setup
plugins.security.disabled: true
{% endif %}
