# JVM Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Xms represents the initial size of total heap space
# Xmx represents the maximum size of total heap space
# Both values should be the same to prevent heap resizing

-Xms{{ elasticsearch_heap_size }}
-Xmx{{ elasticsearch_heap_size }}

# Bootstrap system call filter (seccomp)
{% if elasticsearch_system_call_filter == "false" %}
# Disable for containerized/VM environments without seccomp kernel support
-Des.set.netty.runtime.available.processors=false
-Dorg.elasticsearch.bootstrap.system_call_filter={{ elasticsearch_system_call_filter }}
{% endif %}
