# Mattermost RTCD Configuration
# Generated by Ansible

[api.http]
listen_address = "{{ rtcd_api_listen_address }}"

[api.http.tls]
enable = {{ rtcd_api_tls_enable | lower }}
{% if rtcd_api_tls_cert_file %}
cert_file = "{{ rtcd_api_tls_cert_file }}"
{% endif %}
{% if rtcd_api_tls_cert_key %}
cert_key = "{{ rtcd_api_tls_cert_key }}"
{% endif %}

[api.security]
allow_self_registration = {{ rtcd_security_allow_self_registration | lower }}
enable_admin = {{ rtcd_security_enable_admin | lower }}
{% if rtcd_security_admin_secret_key %}
admin_secret_key = "{{ rtcd_security_admin_secret_key }}"
{% endif %}

[api.security.session_cache]
expiration_minutes = {{ rtcd_security_session_cache_expiration_minutes }}

[rtc]
ice_port_udp = {{ rtcd_ice_port_udp }}
ice_port_tcp = {{ rtcd_ice_port_tcp }}
{% if rtcd_ice_address_udp %}
ice_address_udp = "{{ rtcd_ice_address_udp }}"
{% endif %}
{% if rtcd_ice_address_tcp %}
ice_address_tcp = "{{ rtcd_ice_address_tcp }}"
{% endif %}
enable_ipv6 = {{ rtcd_enable_ipv6 | lower }}
{% if rtcd_ice_host_override %}
ice_host_override = "{{ rtcd_ice_host_override }}"
{% endif %}

{% if rtcd_ice_servers %}
ice_servers = [
{%- for server in rtcd_ice_servers %}
    {urls = {{ server.urls | to_json }}{% if server.username is defined %}, username = "{{ server.username }}"{% endif %}{% if server.credential is defined %}, credential = "{{ server.credential }}"{% endif %}}{% if not loop.last %},{% endif %}

{%- endfor %}
]
{% endif %}

{% if rtcd_turn_static_auth_secret | length > 0 %}
[rtc.turn]
static_auth_secret = "{{ rtcd_turn_static_auth_secret }}"
credentials_expiration_minutes = {{ rtcd_turn_credentials_expiration_minutes }}
{% endif %}

[store]
data_source = "{{ rtcd_data_path }}/db"

[logger.console]
enable = {{ rtcd_logger_enable_console | lower }}
level = "{{ rtcd_logger_console_level }}"
json = {{ rtcd_logger_console_json | lower }}

[logger.file]
enable = {{ rtcd_logger_enable_file | lower }}
{% if rtcd_logger_enable_file %}
path = "{{ rtcd_logger_file_path }}"
level = "{{ rtcd_logger_file_level }}"
json = {{ rtcd_logger_file_json | lower }}
{% endif %}
