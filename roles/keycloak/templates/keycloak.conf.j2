# Keycloak configuration file
# Generated by Ansible - do not edit manually

# Database
db={{ keycloak_db_vendor }}
db-url-host={{ keycloak_db_host }}
db-url-port={{ keycloak_db_port }}
db-url-database={{ keycloak_db_name }}
db-schema={{ keycloak_db_schema }}
db-username={{ keycloak_db_user }}
db-password={{ keycloak_db_password }}

# HTTP(S) Configuration
{% if keycloak_http_enabled %}
http-enabled=true
http-port={{ keycloak_http_port }}
http-host={{ keycloak_http_host }}
{% endif %}

{% if keycloak_https_enabled %}
https-port={{ keycloak_https_port }}
https-certificate-file={{ keycloak_https_certificate_file }}
https-certificate-key-file={{ keycloak_https_certificate_key_file }}
{% endif %}

# Hostname
hostname={{ keycloak_hostname }}
hostname-strict={{ keycloak_hostname_strict | lower }}
hostname-strict-https={{ keycloak_hostname_strict_https | lower }}

# Health and metrics
{% if keycloak_health_enabled %}
health-enabled=true
{% endif %}

{% if keycloak_metrics_enabled %}
metrics-enabled=true
{% endif %}

# Logging
log-level={{ keycloak_log_level }}
log-console-output={{ keycloak_log_console_output }}
