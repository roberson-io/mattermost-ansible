# Coturn TURN/STUN server configuration for Mattermost Calls
# Generated by Ansible - Do not edit manually

# Listening IP address
listening-ip={{ coturn_listening_ip }}

{% if coturn_external_ip %}
# External IP address (for NAT)
external-ip={{ coturn_external_ip }}
{% endif %}

{% if coturn_relay_ip != coturn_listening_ip %}
# Relay IP address
relay-ip={{ coturn_relay_ip }}
{% endif %}

# Listening ports
listening-port={{ coturn_listening_port }}
{% if coturn_tls_enabled %}
tls-listening-port={{ coturn_tls_listening_port }}
{% endif %}

# Relay ports range
min-port={{ coturn_min_port }}
max-port={{ coturn_max_port }}

# Realm (used for authentication)
realm={{ coturn_realm }}
server-name={{ coturn_server_name }}

# Authentication
{% if coturn_use_auth_secret %}
use-auth-secret
static-auth-secret={{ coturn_static_auth_secret }}
{% endif %}

{% if coturn_enable_long_term_credential %}
lt-cred-mech
{% endif %}

# User database
{% if coturn_user_db_type == "sqlite" %}
userdb={{ coturn_user_db_path }}
{% elif coturn_user_db_type == "postgresql" %}
psql-userdb={{ coturn_psql_userdb }}
{% endif %}

# TLS/SSL configuration
{% if coturn_tls_enabled %}
cert={{ coturn_cert_file }}
pkey={{ coturn_key_file }}
{% if coturn_dh_file %}
dh-file={{ coturn_dh_file }}
{% endif %}
{% endif %}

# Security options
{% if coturn_fingerprint %}
fingerprint
{% endif %}

{% if coturn_no_multicast_peers %}
no-multicast-peers
{% endif %}

{% if coturn_no_loopback_peers %}
no-loopback-peers
{% endif %}

{% if coturn_no_cli %}
no-cli
{% endif %}

# Logging
{% if coturn_verbose %}
verbose
{% endif %}

{% if coturn_log_file %}
log-file={{ coturn_log_file }}
{% endif %}

{% if coturn_syslog %}
syslog
{% endif %}

# Performance tuning
{% if coturn_max_bps > 0 %}
max-bps={{ coturn_max_bps }}
{% endif %}

{% if coturn_bps_capacity > 0 %}
bps-capacity={{ coturn_bps_capacity }}
{% endif %}

stale-nonce={{ coturn_stale_nonce }}
max-allocate-lifetime={{ coturn_max_allocate_lifetime }}

# Process management
pidfile={{ coturn_pid_file }}
proc-user={{ coturn_user }}
proc-group={{ coturn_group }}

# Do not allow peers on the loopback addresses
no-loopback-peers

# Do not allow peers on well-known broadcast addresses
no-multicast-peers

# Deny traffic to private IP ranges (security)
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
