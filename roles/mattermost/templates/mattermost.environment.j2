# Mattermost environment configuration
# This file is loaded by systemd when mattermost_config_storage is set to "database"

# MM_CONFIG points to database instead of file-based config.json
# When set, Mattermost stores configuration in the database
MM_CONFIG='postgres://{{ mattermost_db_user }}:{{ mattermost_db_password }}@{{ mattermost_db_host }}:{{ mattermost_db_port }}/{{ mattermost_db_name }}?sslmode={{ mattermost_db_sslmode }}&connect_timeout=10'

# Service environment (production, test, or dev)
MM_SERVICEENVIRONMENT={{ mattermost_service_environment }}

# Enable local mode for mmctl (required for license upload and configuration)
MM_SERVICESETTINGS_ENABLELOCALMODE=true
