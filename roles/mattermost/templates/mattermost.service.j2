[Unit]
Description=Mattermost
After=network.target

[Service]
Type=notify
ExecStart={{ mattermost_install_path }}/bin/mattermost
TimeoutStartSec=3600
KillMode=mixed
Restart=always
RestartSec=10
WorkingDirectory={{ mattermost_install_path }}
User=mattermost
Group=mattermost
LimitNOFILE=49152
{% if mattermost_config_storage == "database" %}
EnvironmentFile={{ mattermost_install_path }}/config/mattermost.environment
{% else %}
Environment="MM_SERVICEENVIRONMENT={{ mattermost_service_environment }}"
{% endif %}

[Install]
WantedBy=multi-user.target
