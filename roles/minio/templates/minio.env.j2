# MinIO Configuration
# DO NOT EDIT - Managed by Ansible

# Root credentials
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# Site configuration
MINIO_SITE_REGION={{ minio_site_region }}

# Browser access
MINIO_BROWSER={{ minio_browser }}

{% if minio_enable_tls %}
# TLS Configuration
MINIO_CERT_FILE={{ minio_cert_file }}
MINIO_KEY_FILE={{ minio_key_file }}
{% endif %}
