[Unit]
Description=MinIO Object Storage
Documentation=https://min.io/docs/minio/linux/index.html
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User={{ minio_user }}
Group={{ minio_group }}
WorkingDirectory={{ minio_install_path }}
EnvironmentFile={{ minio_config_path }}/minio.env
ExecStart={{ minio_install_path }}/bin/minio server {{ minio_data_path }} --address {{ minio_address }} --console-address {{ minio_console_address }}
Restart=always
RestartSec=10s
LimitNOFILE=65536
TimeoutStopSec=infinity
SendSIGKILL=no

# Security
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ minio_data_path }}

[Install]
WantedBy=multi-user.target
