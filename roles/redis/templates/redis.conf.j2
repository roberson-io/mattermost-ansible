# Redis configuration file
# Generated by Ansible - DO NOT EDIT MANUALLY

################################## NETWORK #####################################

# Bind to specific address (0.0.0.0 for all interfaces)
bind {{ redis_bind_address }}

# Accept connections on the specified port
port {{ redis_port }}

# TCP listen() backlog
tcp-backlog {{ redis_tcp_backlog }}

# Close connection after client is idle for N seconds (0 to disable)
timeout {{ redis_timeout }}

# TCP keepalive
tcp-keepalive {{ redis_tcp_keepalive }}

# Protected mode
protected-mode {{ redis_protected_mode }}

################################# GENERAL #####################################

# By default Redis does not run as a daemon (systemd manages it)
daemonize no

# If run by systemd, signal systemd when ready
supervised systemd

# Process ID file
pidfile /var/run/redis/redis.pid

# Logging level
loglevel {{ redis_loglevel }}

# Log file location
logfile {{ redis_logfile }}

# Syslog
syslog-enabled {{ redis_syslog_enabled }}

# Number of databases
databases {{ redis_databases }}

################################ SNAPSHOTTING  ################################

{% if redis_save_enabled %}
# Save the DB to disk
{% for interval in redis_save_intervals %}
save {{ interval }}
{% endfor %}
{% else %}
# Persistence disabled
save ""
{% endif %}

# Stop accepting writes if RDB snapshots fail
stop-writes-on-bgsave-error {{ redis_stop_writes_on_bgsave_error }}

# Compress string objects using LZF when dump .rdb databases
rdbcompression {{ redis_rdbcompression }}

# Add a CRC64 checksum at the end of the file
rdbchecksum {{ redis_rdbchecksum }}

# The filename where to dump the DB
dbfilename {{ redis_dbfilename }}

# The working directory
dir {{ redis_dir }}

################################# REPLICATION #################################

{% if redis_replication_enabled %}
# Replica read-only mode
replica-read-only {{ redis_replica_read_only }}

# Replication backlog size
repl-backlog-size {{ redis_repl_backlog_size }}
{% endif %}

################################## SECURITY ###################################

{% if redis_requirepass %}
# Require password authentication
requirepass {{ redis_requirepass }}
{% endif %}

{% if redis_disable_commands | length > 0 %}
# Disable dangerous commands
{% for command in redis_disable_commands %}
rename-command {{ command }} ""
{% endfor %}
{% endif %}

################################### CLIENTS ####################################

# Max number of connected clients (default: 10000)
# maxclients 10000

############################## MEMORY MANAGEMENT ################################

# Maximum memory limit
maxmemory {{ redis_maxmemory }}

# Eviction policy
maxmemory-policy {{ redis_maxmemory_policy }}

# LRU/LFU/minimal TTL algorithm precision
maxmemory-samples {{ redis_maxmemory_samples }}

############################# LAZY FREEING ####################################

lazyfree-lazy-eviction no
lazyfree-lazy-expire no
lazyfree-lazy-server-del no
replica-lazy-flush no

############################## APPEND ONLY MODE ###############################

# AOF disabled by default (RDB is sufficient for Mattermost cache)
appendonly no

################################ REDIS CLUSTER  ###############################

# Cluster mode disabled by default
# cluster-enabled no

################################## SLOW LOG ###################################

# Slow log configuration
slowlog-log-slower-than {{ redis_slowlog_log_slower_than }}
slowlog-max-len {{ redis_slowlog_max_len }}

################################ LATENCY MONITOR ##############################

# Latency monitoring disabled by default
latency-monitor-threshold 0

############################# EVENT NOTIFICATION ##############################

# Keyspace notifications disabled by default
notify-keyspace-events ""

############################### ADVANCED CONFIG ###############################

# Redis calls an internal function to perform many background tasks
hz {{ redis_hz }}

# Enable active rehashing
activerehashing yes

# AOF rewrite incremental fsync
aof-rewrite-incremental-fsync yes

# RDB save incremental fsync
rdb-save-incremental-fsync yes
