# Nginx configuration for Prometheus
# Managed by Ansible

{% if prometheus_nginx_ssl_enabled %}
# HTTPS server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ prometheus_nginx_server_name }};

    # SSL configuration
    ssl_certificate {{ nginx_ssl_cert_path | default('/etc/letsencrypt/live/' + prometheus_nginx_server_name + '/fullchain.pem') }};
    ssl_certificate_key {{ nginx_ssl_key_path | default('/etc/letsencrypt/live/' + prometheus_nginx_server_name + '/privkey.pem') }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Logging
    access_log /var/log/nginx/prometheus_access.log;
    error_log /var/log/nginx/prometheus_error.log;

    # Proxy settings
    location / {
        proxy_pass http://localhost:{{ prometheus_firewall_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Increase timeouts for long queries
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}

# HTTP redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ prometheus_nginx_server_name }};
    return 301 https://$host$request_uri;
}
{% else %}
# HTTP server block (no SSL)
server {
    listen 80;
    listen [::]:80;
    server_name {{ prometheus_nginx_server_name }};

    # Logging
    access_log /var/log/nginx/prometheus_access.log;
    error_log /var/log/nginx/prometheus_error.log;

    # Proxy settings
    location / {
        proxy_pass http://localhost:{{ prometheus_firewall_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeouts for long queries
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}
{% endif %}
