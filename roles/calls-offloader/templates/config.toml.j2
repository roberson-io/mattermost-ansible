# Mattermost Calls Offloader Configuration
# Generated by Ansible - Do not edit manually

[api.http]
listen_address = "{{ calls_offloader_api_listen_address }}"

[api.security]
allow_self_registration = {{ calls_offloader_api_security_allow_self_registration | lower }}
enable_admin = {{ calls_offloader_api_security_enable_admin | lower }}
{% if calls_offloader_api_security_admin_secret_key | length > 0 %}
admin_secret_key = "{{ calls_offloader_api_security_admin_secret_key }}"
{% endif %}

[api.security.session_cache]
expiration_minutes = {{ calls_offloader_session_cache_expiration_minutes }}

[store]
data_source = "{{ calls_offloader_data_source }}"

[jobs]
api_type = "{{ calls_offloader_api_type }}"
max_concurrent_jobs = {{ calls_offloader_max_concurrent_jobs }}
failed_jobs_retention_time = "{{ calls_offloader_failed_jobs_retention_time }}"
image_registry = "{{ calls_offloader_image_registry }}"

[logger]
enable_console = {{ calls_offloader_log_enable_console | lower }}
console_level = "{{ calls_offloader_log_level }}"
enable_file = {{ calls_offloader_log_enable_file | lower }}
file_level = "{{ calls_offloader_log_level }}"
file_location = "{{ calls_offloader_log_file_location }}"
