---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  venv/
  .ansible/
  .git/
  roles/rhel9STIG/
  roles/rhel8STIG/
  roles/ubuntu20STIG/
  roles/ubuntu22STIG/
  roles/ubuntu24STIG/
  *.example
